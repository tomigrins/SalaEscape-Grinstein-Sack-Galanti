@{
    ViewData["Title"] = "Index";
}

<main class="Mensaje @ViewBag.ClaseMensaje">
    <div>
        <h1>@ViewBag.h1</h1>
        @if(ViewBag.error != null) {
            <p style="color:red;">@ViewBag.error</p>
        }
        <form action="@Url.Action("ValidarCodigo", "Home")" method = "post">
            Ingrese el código encontrado en esta parte:
            <input type="password" placeholder="Código encontrado" name="codigo">
            <button type="submit" class="boton">@ViewBag.boton</button class= "boton">
        </form>
        <h2 style = "color:black;">@ViewBag.h2</h2>
        <a href="@Url.Action("VolverALaViewAnterior", "Home")">
            <button >Volver a la situación anterior</button>
        </a>
    </div> 
</main>
